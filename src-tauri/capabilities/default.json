{
  "$schema": "https://schema.tauri.app/acl/2",
  "identifier": "default",
  "description": "Default permission set for the application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:default"
  ]
}
